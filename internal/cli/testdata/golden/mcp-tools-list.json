  {
    "description": "Install a soul's SOUL.md where the target harness reads it (counts as a download on positronick.com). It never overwrites: an existing file is an error — pass a different path or remove the file first. A relative path must resolve inside the user's home directory; pass an absolute path to install elsewhere.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "write to this exact file instead of the target's conventional path",
          "type": "string"
        },
        "slug": {
          "description": "the soul's slug, as returned by soul_search",
          "type": "string"
        },
        "target": {
          "description": "install target (default: the harness detected from marker directories, else hermes)",
          "enum": [
            "hermes",
            "claude",
            "cursor",
            "openclaw"
          ],
          "type": "string"
        }
      },
      "required": [
        "slug"
      ],
      "type": "object"
    },
    "name": "soul_install",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "installed": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "type": "integer"
            },
            "path": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "slug",
            "target",
            "path",
            "bytes"
          ],
          "type": "object"
        }
      },
      "required": [
        "installed"
      ],
      "type": "object"
    }
  },
