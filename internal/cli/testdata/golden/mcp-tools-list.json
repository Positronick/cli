[
  {
    "description": "Search positronick.com's registry of verified agent tooling — harnesses, CLIs, MCP servers, agent SDKs, skills, plugins and loops — ranked by fuzzy relevance. Follow up with listing_show for the full record.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "description": "only listings in this category (case-insensitive)",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "maximum number of results",
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "text matched fuzzily against listing names, taglines, publishers, types and tags",
          "type": "string"
        },
        "type": {
          "description": "only listings of this type",
          "enum": [
            "harness",
            "cli",
            "mcp",
            "agent",
            "skill",
            "plugin",
            "loop"
          ],
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "listing_search",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer"
        },
        "listings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "installCmd": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              },
              "sourceUrl": {
                "type": "string"
              },
              "tagline": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": [
              "slug",
              "name",
              "type",
              "tagline",
              "sourceUrl"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "count",
        "listings"
      ],
      "type": "object"
    }
  },
