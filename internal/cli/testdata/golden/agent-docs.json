      "description": "Discover and install agent capabilities from positronick.com",
      "flags": [
        {
          "name": "base-url",
          "shorthand": "",
          "usage": "override the positronick.com API base URL",
          "default": ""
        },
        {
          "name": "json",
          "shorthand": "",
          "usage": "emit machine-readable JSON on stdout",
          "default": "false"
        },
        {
          "name": "no-color",
          "shorthand": "",
          "usage": "disable color output",
          "default": "false"
        },
        {
          "name": "quiet",
          "shorthand": "",
          "usage": "suppress progress output on stderr",
          "default": "false"
        },
        {
          "name": "yes",
          "shorthand": "",
          "usage": "assume yes for confirmation prompts",
          "default": "false"
        }
      ]
    },
